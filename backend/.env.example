# Copy this file to ".env" and fill in your real values. NEVER commit ".env".
# --- Gemini (get a key from Google AI Studio: https://aistudio.google.com) ---
GEMINI_API_KEY=put-your-gemini-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=15

# --- AI model files (from the AI teammate) ---
# Leave these commented to use defaults: backend/model/plant_disease_model.keras, backend/model/class_names.json
# MODEL_PATH=model/plant_disease_model.keras
# CLASS_NAMES_PATH=model/class_names.json
DEFAULT_IMAGE_SIZE=224

# 255 = divide pixels by 255. Use 1 if the model already rescales inside itself
PIXEL_SCALE=1
TOP_K=3

# true = if no model is found, return FAKE demo results (good while model is training)
# false = if no model is found, return an error (use this for final demo!)
ALLOW_MOCK=true

# --- Web server ---
# Comma-separated list of websites allowed to call this backend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_MB=5
